# Execution provider: mock | remote
EXECUTION_PROVIDER=mock

# Required only when EXECUTION_PROVIDER=remote
SANDBOX_API_URL=https://sandbox.example.com
SANDBOX_API_TOKEN=replace-with-server-side-secret

# Persistence provider: memory | future postgres/supabase adapter
PERSISTENCE_PROVIDER=memory

NEXT_PUBLIC_SITE_URL=https://datalytiqs-analytics-lab-cfvc.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
